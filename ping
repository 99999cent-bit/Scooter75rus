name: Keep 18gps Session Alive

on:
  schedule:
    # Запуск каждые 5 минут
    - cron: '*/5 * * * *'
  workflow_dispatch: # Позволяет запустить скрипт вручную при необходимости

jobs:
  ping:
    runs-on: ubuntu-latest
    steps:
      - name: Send Ping to 18gps
        run: |
          curl -s "https://18gps.net/GetDataService.aspx?method=loadUser&mds=e6e63e54fd1942b7a567142742717742"
          echo "Пинг успешно отправлен!"