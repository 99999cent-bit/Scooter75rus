name: Keep 18gps Session Alive (Account 2)

on:
  schedule:
    # Запуск каждые 5 минут
    - cron: '*/5 * * * *'
  workflow_dispatch: # Позволяет запустить скрипт вручную при необходимости

jobs:
  ping:
    runs-on: ubuntu-latest
    steps:
      - name: Send Ping to 18gps for Account 2
        run: |
          curl -s "https://18gps.net/GetDataService.aspx?method=loadUser&mds=58b6007cfd36444a82a97346b9d263dc"
          echo "Пинг для второго аккаунта успешно отправлен!"